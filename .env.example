# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AniLiberty API v1 (only used by the private sync worker, never by browser code)
ANILIBERTY_API_BASE=https://api.anilibria.app/api/v1
SYNC_PAGE_SIZE=50
SYNC_CONCURRENCY=4
SYNC_INCLUDE_EPISODES=true

# Local Supabase CLI email test; in production, set the same value in Supabase Auth → SMTP.
SUPABASE_AUTH_SMTP_PASSWORD=re_your_resend_api_key

# Optional: limit a one-off run while testing. Leave empty to read every catalog page.
SYNC_MAX_PAGES=
